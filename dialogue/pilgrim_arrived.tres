[gd_resource type="Resource" script_class="DialogueSequence" format=3 uid="uid://or5g1303fltv"]

[ext_resource type="Script" uid="uid://b0cflgfqmd74d" path="res://scripts/dialogue/dialogue_line.gd" id="1_line"]
[ext_resource type="Script" uid="uid://0650pa6ei7hh" path="res://scripts/dialogue/dialogue_sequence.gd" id="3_seq"]

[sub_resource type="Resource" id="Resource_v1"]
script = ExtResource("1_line")
speaker = "You"
text = "At the top of the trail the trees open and the valley falls away below - rivers like silver thread, fields like stitched cloth. The old woman steps to the edge and stands looking out over all of it, getting her breath back at last."

[sub_resource type="Resource" id="Resource_v2"]
script = ExtResource("1_line")
speaker = "Dolma"
text = "Worth arguing for."

[resource]
script = ExtResource("3_seq")
id = &"pilgrim_arrived"
lines = Array[ExtResource("1_line")]([SubResource("Resource_v1"), SubResource("Resource_v2")])
