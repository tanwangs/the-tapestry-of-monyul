[sub_resource type="Resource" id="Resource_mgu2k"]
script = ExtResource("1_jmkt8")
speaker = "You"
text = "Five colours on a string, snapping in the wind - blue for sky, white for cloud, red for fire, green for water, yellow for earth."

[sub_resource type="Resource" id="Resource_ijbpt"]
script = ExtResource("1_jmkt8")
speaker = "You"
text = "The flags move, but the sound of them arrives a moment late. You look at your hands instead."

