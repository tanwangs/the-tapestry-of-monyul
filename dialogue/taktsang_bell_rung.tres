[gd_resource type="Resource" script_class="DialogueSequence" format=3 uid="uid://be430cnkcvwhf"]

[ext_resource type="Script" uid="uid://b0cflgfqmd74d" path="res://scripts/dialogue/dialogue_line.gd" id="1_line"]
[ext_resource type="Script" uid="uid://0650pa6ei7hh" path="res://scripts/dialogue/dialogue_sequence.gd" id="2_seq"]

[sub_resource type="Resource" id="Resource_o1"]
script = ExtResource("1_line")
speaker = "You"
text = "You lift the mallet and strike the bronze bell. The sound travels down the cliff face and into the valley below."

[sub_resource type="Resource" id="Resource_o2"]
script = ExtResource("1_line")
speaker = "You"
text = "The tone lingers against the rock and then fades, but the echo stays - the mountain remembers what has been sounded."

[resource]
script = ExtResource("2_seq")
id = &"taktsang_bell_rung"
lines = Array[ExtResource("1_line")]([SubResource("Resource_o1"), SubResource("Resource_o2")])
