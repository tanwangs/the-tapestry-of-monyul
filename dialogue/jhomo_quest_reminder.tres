[sub_resource type="Resource" id="Resource_r1"]
script = ExtResource("1_line")
speaker = "Aum Jomo"
text = "Tsheringma Ney is east along the ledge, where the trail bends. Incense, a lamp and a bowl - carry all three, and set them out gently."
portrait = ExtResource("2_jomo")

[sub_resource type="Resource" id="Resource_r2"]
script = ExtResource("1_line")
speaker = "Aum Jomo"
text = "The mountain is patient. It is also a long way above us. Do not make it wait forever."
portrait = ExtResource("2_jomo")

[resource]
script = ExtResource("3_seq")
id = &"jhomo_quest_reminder"
lines = Array[ExtResource("1_line")]([SubResource("Resource_r1"), SubResource("Resource_r2")])
