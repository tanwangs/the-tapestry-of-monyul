[ext_resource type="Script" uid="uid://b0cflgfqmd74d" path="res://scripts/dialogue/dialogue_line.gd" id="1_line"]
[ext_resource type="Script" uid="uid://0650pa6ei7hh" path="res://scripts/dialogue/dialogue_sequence.gd" id="3_seq"]

[sub_resource type="Resource" id="Resource_h1"]
script = ExtResource("1_line")
speaker = "You"
text = "The incense has burned down and the lamp has gone out, but the stone is still warm, the way a hand is warm after it has held something."

[sub_resource type="Resource" id="Resource_h2"]
script = ExtResource("1_line")
speaker = "You"
text = "You leave the bowl where it is. Someone else will need it."

[resource]
script = ExtResource("3_seq")
id = &"jhomo_altar_honoured"
lines = Array[ExtResource("1_line")]([SubResource("Resource_h1"), SubResource("Resource_h2")])
