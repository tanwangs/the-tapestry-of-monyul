[sub_resource type="Resource" id="Resource_xpklu"]
script = ExtResource("1_s67b4")
speaker = "You"
text = "Something is half a step out of time here. The light is a shade too grey, and the quiet has weight to it."

[sub_resource type="Resource" id="Resource_0cul5"]
script = ExtResource("1_s67b4")
speaker = "You"
text = "The village is holding its breath. Best to start walking."

