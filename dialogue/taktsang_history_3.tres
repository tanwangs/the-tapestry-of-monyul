[gd_resource type="Resource" script_class="DialogueSequence" format=3]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_line.gd" id="1_line"]
[ext_resource type="Texture2D" path="res://assets/generated/taktsang_monk_2.png" id="2_monk"]
[ext_resource type="Script" path="res://scripts/dialogue/dialogue_sequence.gd" id="2_seq"]

[sub_resource type="Resource" id="Resource_h1"]
script = ExtResource("1_line")
speaker = "Monk"
text = "The prayer wheels along the trail are stopped. They hold the mantras of our ancestors, and they must spin again before the evening."
portrait = ExtResource("2_monk")

[sub_resource type="Resource" id="Resource_h2"]
script = ExtResource("1_line")
speaker = "Monk"
text = "Each wheel you set spinning carries a piece of the mountain's intention down into the valley."
portrait = ExtResource("2_monk")

[resource]
script = ExtResource("2_seq")
id = &"taktsang_history_3"
lines = Array[ExtResource("1_line")]([SubResource("Resource_h1"), SubResource("Resource_h2")])
