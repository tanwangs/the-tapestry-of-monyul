[gd_resource type="Resource" script_class="DialogueSequence" format=3 uid="uid://cpv6ox176elfi"]

[ext_resource type="Script" uid="uid://b0cflgfqmd74d" path="res://scripts/dialogue/dialogue_line.gd" id="1_line"]
[ext_resource type="Script" uid="uid://0650pa6ei7hh" path="res://scripts/dialogue/dialogue_sequence.gd" id="3_seq"]

[sub_resource type="Resource" id="Resource_i1"]
script = ExtResource("1_line")
speaker = "You"
text = "A bundle of incense sticks, wrapped in paper the colour of old butter, tucked into a crack in the rock by the path. Someone left these here for whoever came next."

[sub_resource type="Resource" id="Resource_i2"]
script = ExtResource("1_line")
speaker = "You"
text = "You take three and put the rest back, exactly as you found them."

[resource]
script = ExtResource("3_seq")
id = &"jhomo_item_incense"
lines = Array[ExtResource("1_line")]([SubResource("Resource_i1"), SubResource("Resource_i2")])
