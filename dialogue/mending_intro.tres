[gd_resource type="Resource" script_class="DialogueSequence" format=3 uid="uid://sfqqhoqx75fq"]

[ext_resource type="Script" uid="uid://b0cflgfqmd74d" path="res://scripts/dialogue/dialogue_line.gd" id="1_line"]
[ext_resource type="Script" uid="uid://0650pa6ei7hh" path="res://scripts/dialogue/dialogue_sequence.gd" id="3_seq"]

[sub_resource type="Resource" id="Resource_v1"]
script = ExtResource("1_line")
speaker = "You"
text = "A woman sits on a pile of nets at the water's edge, sorting cord by hand. Behind her, a reed platform leans at a tired angle over the shallows, one corner folded into the water."

[sub_resource type="Resource" id="Resource_v2"]
script = ExtResource("1_line")
speaker = "Choden"
text = "The storm took the corner of my platform and put a rip in the good net. That's the third time in my life, and it's always the same corner."

[sub_resource type="Resource" id="Resource_v3"]
script = ExtResource("1_line")
speaker = "Choden"
text = "The lake gives if you don't take everything. It took its share, that's all. Now I need to mend what's left - but my knees are done with wading today."

[sub_resource type="Resource" id="Resource_v4"]
script = ExtResource("1_line")
speaker = "Choden"
text = "There are three stands of reed along the shore the old rules say may be cut. Bring me what they'll give - only those three, only what's ready - and we'll lash the thing back together, you and I."

[sub_resource type="Resource" id="Resource_v5"]
script = ExtResource("1_line")
speaker = "You"
text = "She points them out without getting up: one stand on the west shore, one on the north, one on the east. \"The rest are the lake's,\" she says, and goes back to her cord."

[resource]
script = ExtResource("3_seq")
id = &"mending_intro"
lines = Array[ExtResource("1_line")]([SubResource("Resource_v1"), SubResource("Resource_v2"), SubResource("Resource_v3"), SubResource("Resource_v4"), SubResource("Resource_v5")])
